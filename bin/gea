#!/usr/bin/env bash
set -Eeuo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

python_ok() {
  local candidate="$1"
  command -v "$candidate" >/dev/null 2>&1 || return 1
  "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1
}

select_python() {
  local candidate

  if [[ -n "${GEA_PYTHON:-}" ]]; then
    if python_ok "$GEA_PYTHON"; then
      printf '%s\n' "$GEA_PYTHON"
      return 0
    fi
    echo "GEA_PYTHON='$GEA_PYTHON' tidak tersedia atau versinya < 3.10." >&2
    return 1
  fi

  for candidate in python3 python3.13 python3.12 python3.11 python3.10; do
    if python_ok "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  echo "Python >= 3.10 tidak ditemukan." >&2
  echo "Debian/Ubuntu/Kali: instal Python 3.10+ dari repository distro." >&2
  echo "Rocky Linux 9/RHEL 9: sudo dnf install -y python3.11" >&2
  return 1
}

PYTHON_BIN="$(select_python)"
exec "$PYTHON_BIN" "$ROOT_DIR/gea/cli.py" "$@"
