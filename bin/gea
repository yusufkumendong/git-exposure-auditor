#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/common.sh"
source "$ROOT_DIR/lib/scope.sh"
source "$ROOT_DIR/lib/input.sh"
source "$ROOT_DIR/lib/http_client.sh"
source "$ROOT_DIR/lib/reporter.sh"
source "$ROOT_DIR/lib/scanner.sh"

MODE="easy"
TARGET_LIST=""
SCOPE_FILE=""
AUTHORIZED=false
ALLOW_PRIVATE=false
INSECURE=false
QUIET=false
VERBOSE=false
NO_COLOR=false
CONCURRENCY=1
CONCURRENCY_SET=false
RATE_LIMIT="0"
RATE_SET=false
CONNECT_TIMEOUT=5
MAX_TIME=15
MAX_BODY_BYTES=262144
REPORT_DIR=""
USER_AGENT="Git-Exposure-Auditor/${GEA_VERSION} (+authorized-security-research)"
RETRIES=0
RETRIES_SET=false
RETRY_DELAY=1
RETRY_MAX_DELAY=10
RESPECT_RETRY_AFTER=true
PROXY_URL=""
HTTP_VERSION="auto"
CUSTOM_HEADERS=()
DISCOVER_WILDCARDS=true
ENUMERATOR="auto"
MAX_DISCOVERED=300
SCHEME_MODE="https"
FAIL_ON_FINDINGS=false
WORK_DIR=""

usage() {
  cat <<'EOF_USAGE'
Usage tanpa TXT:
  gea --mode easy --domain example.com
  gea --mode medium --subdomain app.example.com
  gea --mode hard --domain example.com --subdomain api.example.com
  gea --mode best-practice --wildcard '*.example.com' --authorized

Input:
  --target URL             URL langsung; dapat diulang atau dipisahkan koma
  --domain DOMAIN          Domain root langsung; dapat diulang/dipisahkan koma
  --subdomain HOST         Subdomain langsung; dapat diulang/dipisahkan koma
  --wildcard '*.DOMAIN'    Scope wildcard + enumerasi pasif subdomain
  --list FILE              Kompatibilitas lama: target per baris
  --scope FILE             Kompatibilitas lama: exact/wildcard scope per baris
  --scope-rule RULE        Scope langsung tanpa file; dapat diulang

Wildcard discovery:
  --enumerator MODE        auto | subfinder | crtsh | none (default: auto)
  --no-discover            Jangan enumerasi; scan root wildcard saja
  --max-discovered N       Maksimal host hasil enumerasi (default: 300)

Safety dan request:
  --authorized             Konfirmasi izin/scope program
  --allow-private          Izinkan private IP; wajib --authorized
  --concurrency N          1-20; Best Practice maksimal 5
  --rate RPS               0-50; Best Practice maksimal 5
  --retries N              0-5
  --retry-delay SEC        Delay awal retry
  --retry-max-delay SEC    Maksimal backoff
  --no-retry-after         Abaikan header Retry-After
  --connect-timeout SEC    Default 5
  --max-time SEC           Default 15
  --max-body-bytes N       Default 262144
  --proxy URL              Proxy HTTP/SOCKS yang diizinkan
  --header 'Name: value'   Header tambahan; dapat diulang
  --http-version MODE      auto | 1.1 | 2
  --scheme MODE            https | http | both untuk input tanpa scheme
  --insecure               Abaikan validasi TLS

Output:
  --report-dir DIR         Lokasi laporan
  --quiet                  Hanya laporan/ringkasan minimum
  --verbose                Debug aman tanpa body response
  --no-color               Matikan warna
  --fail-on-findings       Exit code 10 jika confirmed/probable ditemukan
  --version                Tampilkan versi
  -h, --help               Bantuan

Catatan: wildcard harus diberi tanda kutip agar shell tidak mengembangkannya.
Best Practice wajib --authorized dan scope akan otomatis dibuat dari input langsung.
EOF_USAGE
}

cleanup() {
  [[ -n "${WORK_DIR:-}" && -d "$WORK_DIR" ]] && rm -rf "$WORK_DIR"
  return 0
}
trap cleanup EXIT INT TERM

while (($#)); do
  case "$1" in
    --mode) MODE="${2:-}"; shift 2 ;;
    --target) add_csv_values TARGET_INPUTS "${2:-}"; shift 2 ;;
    --domain) add_csv_values DOMAIN_INPUTS "${2:-}"; shift 2 ;;
    --subdomain) add_csv_values SUBDOMAIN_INPUTS "${2:-}"; shift 2 ;;
    --wildcard) add_csv_values WILDCARD_INPUTS "${2:-}"; shift 2 ;;
    --list) TARGET_LIST="${2:-}"; shift 2 ;;
    --scope) SCOPE_FILE="${2:-}"; shift 2 ;;
    --scope-rule) add_scope_rule "${2:-}"; shift 2 ;;
    --authorized) AUTHORIZED=true; shift ;;
    --allow-private) ALLOW_PRIVATE=true; shift ;;
    --concurrency) CONCURRENCY="${2:-}"; CONCURRENCY_SET=true; shift 2 ;;
    --rate) RATE_LIMIT="${2:-}"; RATE_SET=true; shift 2 ;;
    --retries) RETRIES="${2:-}"; RETRIES_SET=true; shift 2 ;;
    --retry-delay) RETRY_DELAY="${2:-}"; shift 2 ;;
    --retry-max-delay) RETRY_MAX_DELAY="${2:-}"; shift 2 ;;
    --no-retry-after) RESPECT_RETRY_AFTER=false; shift ;;
    --connect-timeout) CONNECT_TIMEOUT="${2:-}"; shift 2 ;;
    --max-time) MAX_TIME="${2:-}"; shift 2 ;;
    --max-body-bytes) MAX_BODY_BYTES="${2:-}"; shift 2 ;;
    --proxy) PROXY_URL="${2:-}"; shift 2 ;;
    --header) CUSTOM_HEADERS+=("${2:-}"); shift 2 ;;
    --http-version) HTTP_VERSION="${2:-}"; shift 2 ;;
    --report-dir) REPORT_DIR="${2:-}"; shift 2 ;;
    --insecure) INSECURE=true; shift ;;
    --enumerator) ENUMERATOR="${2:-}"; shift 2 ;;
    --no-discover) DISCOVER_WILDCARDS=false; shift ;;
    --max-discovered) MAX_DISCOVERED="${2:-}"; shift 2 ;;
    --scheme) SCHEME_MODE="${2:-}"; shift 2 ;;
    --quiet) QUIET=true; shift ;;
    --verbose) VERBOSE=true; shift ;;
    --no-color) NO_COLOR=true; shift ;;
    --fail-on-findings) FAIL_ON_FINDINGS=true; shift ;;
    --version) printf '%s\n' "$GEA_VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *) die "Argumen tidak dikenal: $1" ;;
  esac
done

require_cmd curl; require_cmd jq; require_cmd python3
[[ "$MODE" =~ ^(easy|medium|hard|best-practice)$ ]] || die "Mode tidak valid: $MODE"
[[ "$HTTP_VERSION" =~ ^(auto|1\.1|2)$ ]] || die "--http-version harus auto, 1.1, atau 2"
[[ "$SCHEME_MODE" =~ ^(https|http|both)$ ]] || die "--scheme harus https, http, atau both"
[[ "$ENUMERATOR" =~ ^(auto|subfinder|crtsh|none)$ ]] || die "Enumerator tidak valid"
[[ "$CONCURRENCY" =~ ^[0-9]+$ ]] && ((CONCURRENCY >= 1 && CONCURRENCY <= 20)) || die "Concurrency harus 1-20"
[[ "$RETRIES" =~ ^[0-9]+$ ]] && ((RETRIES >= 0 && RETRIES <= 5)) || die "Retries harus 0-5"
[[ "$MAX_DISCOVERED" =~ ^[0-9]+$ ]] && ((MAX_DISCOVERED >= 1 && MAX_DISCOVERED <= 2000)) || die "max-discovered harus 1-2000"
[[ "$MAX_BODY_BYTES" =~ ^[0-9]+$ ]] && ((MAX_BODY_BYTES >= 1024 && MAX_BODY_BYTES <= 1048576)) || die "max-body-bytes harus 1024-1048576"
python3 - "$RATE_LIMIT" "$RETRY_DELAY" "$RETRY_MAX_DELAY" <<'PY' || exit 1
import sys
values=list(map(float,sys.argv[1:]))
if not 0 <= values[0] <= 50: raise SystemExit("Rate harus 0-50")
if values[1] < 0 or values[2] < values[1]: raise SystemExit("Konfigurasi retry delay tidak valid")
PY

case "$MODE" in
  easy) $RETRIES_SET || RETRIES=0 ;;
  medium) $CONCURRENCY_SET || CONCURRENCY=2; $RATE_SET || RATE_LIMIT=3; $RETRIES_SET || RETRIES=1 ;;
  hard) $CONCURRENCY_SET || CONCURRENCY=5; $RATE_SET || RATE_LIMIT=5; $RETRIES_SET || RETRIES=1 ;;
  best-practice)
    $AUTHORIZED || die "Best Practice wajib memakai --authorized"
    $CONCURRENCY_SET || CONCURRENCY=3; $RATE_SET || RATE_LIMIT=2; $RETRIES_SET || RETRIES=1
    ((CONCURRENCY <= 5)) || die "Best Practice: concurrency maksimal 5"
    python3 - "$RATE_LIMIT" <<'PY' || exit 1
import sys
if float(sys.argv[1]) > 5: raise SystemExit("Best Practice: rate maksimal 5 request/detik")
PY
    ;;
esac

if ((${#WILDCARD_INPUTS[@]} > 0)); then
  $AUTHORIZED || die "Input wildcard wajib memakai --authorized karena dapat mencakup banyak aset"
fi
if $ALLOW_PRIVATE; then $AUTHORIZED || die "--allow-private wajib disertai --authorized"; fi
[[ -n "$SCOPE_FILE" ]] && load_scope_rules "$SCOPE_FILE"

input_count=$((${#TARGET_INPUTS[@]} + ${#DOMAIN_INPUTS[@]} + ${#SUBDOMAIN_INPUTS[@]} + ${#WILDCARD_INPUTS[@]}))
((input_count > 0)) || [[ -n "$TARGET_LIST" ]] || die "Berikan --target, --domain, --subdomain, atau --wildcard"

build_target_urls
((${#TARGETS[@]} > 0)) || die "Tidak ada target valid dan in-scope"
if [[ "$MODE" == "best-practice" ]] && ((${#SCOPE_RULES[@]} == 0)); then die "Best Practice membutuhkan scope"; fi

select_endpoints "$MODE"
WORK_DIR="$(mktemp -d -t gea-v31.XXXXXX)"
init_reporter
print_banner; legal_notice
if [[ "$QUIET" != "true" ]]; then
  printf '\nMode          : %s\nTarget        : %d\nEndpoint/host : %d + 1 baseline\nConcurrency   : %s\nRate limit    : %s req/s\nRetries       : %s\nReport        : %s\n\n' \
    "$MODE" "${#TARGETS[@]}" "${#ENDPOINTS[@]}" "$CONCURRENCY" "$RATE_LIMIT" "$RETRIES" "$REPORT_DIR"
fi

run_scan_jobs "${TARGETS[@]}"
consume_results
[[ "$QUIET" == "true" ]] || printf '\n'
build_summary

if $FAIL_ON_FINDINGS && jq -e 'select(.classification=="confirmed_exposure" or .classification=="probable_exposure")' "$JSONL_FILE" >/dev/null; then
  exit 10
fi
