{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Git Exposure Auditor Authorized Advanced Policy",
  "type": "object",
  "required": ["program", "permissions"],
  "properties": {
    "program": {
      "type": "object",
      "required": ["name", "policy_reference", "authorization_confirmed", "bypass_permission_confirmed"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "policy_reference": {"type": "string", "minLength": 1},
        "authorization_confirmed": {"const": true},
        "bypass_permission_confirmed": {"const": true}
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "required": ["advanced_validation"],
      "properties": {
        "advanced_validation": {"const": true},
        "waf_bypass_testing": {"type": "boolean"},
        "alternate_headers": {"type": "boolean"},
        "alternate_methods": {"type": "boolean"},
        "rate_limit_testing": {"type": "boolean"},
        "repository_download": {"type": "boolean"},
        "credential_testing": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
